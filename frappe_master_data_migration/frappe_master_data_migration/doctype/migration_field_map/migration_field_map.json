 "fields": [
  {
   "fieldname": "child_table",
   "fieldtype": "Data",
   "label": "Child Table",
   "in_list_view": 1,
   "columns": 2,
   "description": "Leave blank to apply everywhere. Enter a child table fieldname (e.g. item_defaults, accounts) to apply only inside that table."
  },
  {
   "fieldname": "target_fieldname",
   "fieldtype": "Data",
   "label": "Field",
   "reqd": 1,
   "in_list_view": 1,
   "columns": 2,
   "description": "Fieldname to change, e.g. company or income_account"
  },
  {
   "fieldname": "map_type",
   "fieldtype": "Select",
   "label": "Action",
   "options": "Replace Value\nSet Fixed Value\nClear Value",
   "default": "Set Fixed Value",
   "reqd": 1,
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "target_doctype",
   "fieldtype": "Link",
   "options": "DocType",
   "label": "Value DocType",
   "description": "Auto-detected for Link fields. Set it to pick the value below from a list.",
   "depends_on": "eval:doc.map_type!='Clear Value'"
  },
  {
   "fieldname": "from_value",
   "fieldtype": "Data",
   "label": "From Value",
   "depends_on": "eval:doc.map_type=='Replace Value'",
   "description": "Replace only rows whose current value equals this."
  },
  {
   "fieldname": "to_value",
   "fieldtype": "Data",
   "label": "To Value",
   "in_list_view": 1,
   "columns": 2,
   "depends_on": "eval:doc.map_type!='Clear Value' && !doc.target_doctype"
  },
  {
   "fieldname": "to_value_link",
   "fieldtype": "Dynamic Link",
   "options": "target_doctype",
   "label": "Pick Value",
   "in_list_view": 1,
   "columns": 2,
   "depends_on": "eval:doc.map_type!='Clear Value' && doc.target_doctype"
  }
