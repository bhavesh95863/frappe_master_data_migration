 "fields": [
  {
   "fieldname": "connection",
   "fieldtype": "Link",
   "options": "Migration Connection",
   "label": "Connection",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "source_doctype",
   "fieldtype": "Data",
   "label": "Source DocType",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Name of the DocType to pull from the source site, e.g. Customer"
  },
  {
   "fieldname": "column_break_src",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "Draft\nQueued\nRunning\nStopping\nStopped\nCompleted\nCompleted with Errors\nFailed",
   "default": "Draft",
   "label": "Status",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section_break_scope",
   "fieldtype": "Section Break",
   "label": "Scope"
  },
  {
   "fieldname": "filters_json",
   "fieldtype": "Small Text",
   "label": "Filters (JSON)",
   "description": "Optional. Frappe filters as JSON, e.g. {\"disabled\": 0} or [[\"creation\", \">\", \"2024-01-01\"]]"
  },
  {
   "fieldname": "modified_after",
   "fieldtype": "Datetime",
   "label": "Modified After",
   "description": "Optional. Only pull records modified after this time (incremental sync)."
  },
  {
   "fieldname": "column_break_scope",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "record_limit",
   "fieldtype": "Int",
   "label": "Record Limit",
   "description": "Optional cap on number of records (0 = all)."
  },
  {
   "fieldname": "section_break_rules",
   "fieldtype": "Section Break",
   "label": "Rules"
  },
  {
   "fieldname": "on_conflict",
   "fieldtype": "Select",
   "options": "Skip\nOverwrite",
   "default": "Skip",
   "label": "If Record Already Exists",
   "reqd": 1
  },
  {
   "fieldname": "missing_link_action",
   "fieldtype": "Select",
   "options": "Report & Continue\nAuto-create Stub\nSkip Record",
   "default": "Report & Continue",
   "label": "If a Linked Record is Missing",
   "reqd": 1
  },
  {
   "fieldname": "ignore_validations",
   "fieldtype": "Check",
   "label": "Skip Validations (import raw data)",
   "default": "0",
   "description": "Bypass the target DocType's validate rules (e.g. 'account does not belong to company'). Use when the source data is trusted and destination-specific business rules block the import. May create records that violate those rules — prefer deselecting the offending child table or mapping its values when possible."
  },
  {
   "fieldname": "section_break_extras",
   "fieldtype": "Section Break",
   "label": "What to Transfer"
  },
  {
   "fieldname": "include_files",
   "fieldtype": "Check",
   "label": "Include File Attachments",
   "default": "0"
  },
  {
   "fieldname": "include_comments",
   "fieldtype": "Check",
   "label": "Include Comments",
   "default": "0"
  },
  {
   "fieldname": "column_break_extras",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "include_versions",
   "fieldtype": "Check",
   "label": "Include Version History",
   "default": "0"
  },
  {
   "fieldname": "include_assignments_tags",
   "fieldtype": "Check",
   "label": "Include Assignments & Tags",
   "default": "0"
  },
  {
   "fieldname": "include_address_contact",
   "fieldtype": "Check",
   "label": "Include linked Addresses & Contacts",
   "default": "0",
   "description": "Also migrate all Addresses & Contacts linked to each record (e.g. a Customer's or Supplier's addresses). These are kept out of the Link Resolution list."
  },
  {
   "fieldname": "section_break_children",
   "fieldtype": "Section Break",
   "label": "Child Tables",
   "description": "Click 'Fetch Meta' to load the child tables of the selected DocType, then deselect any you don't want."
  },
  {
   "fieldname": "child_tables",
   "fieldtype": "Table",
   "options": "Migration Child Table Option",
   "label": "Child Tables"
  },
  {
   "fieldname": "section_break_links",
   "fieldtype": "Section Break",
   "label": "Link Resolution",
   "description": "Click 'Analyze Links' to load every distinct Link value used in the source (parent + selected child tables). For each value choose Keep, Map (pick an existing record here), or Create New (pull it from the source)."
  },
  {
   "fieldname": "link_resolutions",
   "fieldtype": "Table",
   "options": "Migration Link Resolution",
   "label": "Link Resolutions"
  },
  {
   "fieldname": "section_break_mappings",
   "fieldtype": "Section Break",
   "label": "Value Mapping Rules",
   "description": "Transform field values during import. Remap Company 'Acme Pvt Ltd' to 'Acme Limited', or scope a rule to a child table (e.g. set Company / clear income_account inside item_defaults or accounts) so company-specific defaults resolve on this site. To skip company-specific defaults entirely, deselect that child table above."
  },
  {
